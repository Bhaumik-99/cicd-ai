# ============================================
# CICD-AI Git Ignore
# ============================================

# Environment variables & secrets
.env
.env.local
.env.*.local
*.env

# Keep template
!.env.example

# Java / Maven build outputs
**/target/
**/*.class
**/*.jar
**/*.war
**/*.nar
**/*.ear
**/*.zip
**/*.tar.gz
**/*.rar

# Node / Frontend dependencies & outputs
**/node_modules/
**/dist/
**/dist-ssr/
**/.eslintcache
**/.parcel-cache
**/.turbo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Vercel deployment cache
.vercel

# IDEs and Editors
.idea/
*.iml
*.iws
*.ipr
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-workspace
*.sublime-project
.classpath
.project
.settings/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Logs & temporary files
*.log
*.tmp
*.temp
logs/
*.pid
*.seed
*.pid.lock

# Docker / local volumes
postgres_data/
redis_data/
kafka_data/
