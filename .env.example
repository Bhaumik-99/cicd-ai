# ============================================
# CICD-AI Environment Configuration
# ============================================
# Copy this file to .env and customize values

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=cicdai
POSTGRES_USER=cicdai
POSTGRES_PASSWORD=cicdai_secret

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# --- API Gateway ---
GATEWAY_PORT=8080

# --- Webhook Service ---
WEBHOOK_PORT=8081
GITHUB_WEBHOOK_SECRET=your-webhook-secret-here

# --- Pipeline Service ---
PIPELINE_PORT=8082

# --- Build Worker ---
WORKER_PORT=8083

# --- AI Analyzer ---
ANALYZER_PORT=8084
LLM_API_KEY=
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini
# If LLM_API_KEY is empty, mock analyzer is used automatically

# --- Failure Service ---
FAILURE_PORT=8085

# --- Notification Service ---
NOTIFICATION_PORT=8086

# --- Frontend ---
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:8080
